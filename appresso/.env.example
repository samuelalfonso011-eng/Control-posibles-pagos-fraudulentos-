# VELUM — Variables de entorno de configuración
# Copia este archivo como .env y ajusta los valores según tu entorno.

# Base de datos (SQLite para dev, PostgreSQL para prod)
DATABASE_URL=sqlite:///./appresso.db
# DATABASE_URL=postgresql://user:password@localhost:5432/velum

# Detector de ventana deslizante
WINDOW_SECONDS=3
BASE_TRANSACTION_THRESHOLD=3
MAX_CLOCK_SKEW_SECONDS=300

# Zona horaria del negocio (para clasificación de franjas horarias)
TIMEZONE=America/Bogota

# Entorno de ejecución
ENVIRONMENT=development

# CORS (separados por coma para múltiples orígenes)
CORS_ORIGINS=http://localhost:8000

# Umbrales de severidad (ratio = count / referencia_franja)
# < SEVERITY_LOW  → BAJO
# < SEVERITY_MEDIUM → MEDIO
# < SEVERITY_HIGH → ALTO
# >= SEVERITY_HIGH → CRITICO
SEVERITY_LOW=0.5
SEVERITY_MEDIUM=1.0
SEVERITY_HIGH=2.0

# Referencias de transacciones por franja horaria (para cálculo de ratio)
REF_MORNING=10    # [05:00, 12:00) hora Bogotá
REF_AFTERNOON=6   # [12:00, 20:00) hora Bogotá
REF_NIGHT=3       # [20:00, 05:00) hora Bogotá
